# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
# (was `docs/` for pkgdown; this project is not a package and uses docs/ for
# project documentation, so ignore only a pkgdown build if one ever appears)
docs/pkgdown/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# discovery scan output (machine-specific, do not commit)
discovery/
discovery-project/
file-index.txt

# mirrored input data (machine-specific, tracked via inst/manifest/, not git)
data-in/
/.uvr/library/
/.uvr/activate*

# IDE config uvr generates, with absolute machine-specific paths in it
.vscode/

# targets store (rebuildable, machine-specific)
_targets/
